# Backend base URL. Use the literal `same-origin` when one host serves the app and
# proxies /api/ (the production setup): requests become relative, so the hostname
# is neither in the bundle nor in the CSP and moving domains needs no rebuild.
# Any other value must be a full absolute URL; leaving it empty is a build error.
NEXT_PUBLIC_API_URL=
# Full FastAPI v1 base URL including /api/v1 when it runs on a separate origin,
# for example http://localhost:8001/api/v1 in local development.
NEXT_PUBLIC_API_V1_URL=
# Optional public S3/CDN base. Its origin is added to CSP img-src; leave empty
# when uploads are served through the app's own origin.
NEXT_PUBLIC_MEDIA_URL=
# Bot link shown on the "open in Telegram" gate when the app is opened outside Telegram.
NEXT_PUBLIC_BOT_URL=https://t.me/your_bot
# Support link shown in the patient profile. Only official Telegram hosts are accepted.
# Where "Yordam" in the profile opens. A t.me link only -- isSafeTelegramUrl
# refuses anything else, and an unusable value silently hides the button rather
# than opening a bad link. The production value lives in the repository
# variable of the same name, because NEXT_PUBLIC_* is baked at build time.
NEXT_PUBLIC_SUPPORT_URL=https://t.me/dentalmap_uz
# Production target: Secure HttpOnly refresh cookie + memory-only access token.
# Use legacy-session only temporarily and only together with the non-public
# ALLOW_LEGACY_SESSION_AUTH=true build flag.
NEXT_PUBLIC_AUTH_TOKEN_MODE=cookie
# Exact Payme checkout hosts returned by the billing API (comma-separated;
# schemes, paths, wildcards and suffix matching are forbidden).
NEXT_PUBLIC_PAYME_CHECKOUT_HOSTS=checkout.paycom.uz,test.paycom.uz
# Set true to require opening the deployed UI from Telegram.
NEXT_PUBLIC_TELEGRAM_ONLY=false
# Same-origin Django admin path used by /superstat (path only, never a full URL).
NEXT_PUBLIC_ADMIN_URL=admin
# Yandex Maps JS API key — enables the in-app Yandex map location picker (best for
# Uzbekistan). This value is public in the browser bundle: restrict it by allowed
# website origins in Yandex Console. Leave empty to use OpenStreetMap instead.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Local/demo mode — register + login create a local account (no backend calls).
# Development only. Never put real patient data into demo mode.
NEXT_PUBLIC_LOCAL_MODE=

# Ommaviy oferta (/oferta) va chekda ko'rsatiladigan rasmiy rekvizitlar. Bo'sh
# qoldirilsa build to'xtamaydi, lekin oferta sahifasida "rekvizitlar
# to'ldirilmagan" ogohlantirishi chiqadi va hujjat huquqiy kuchga ega bo'lmaydi.
# To'lov tizimi (Payme) ularni talab qiladi.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_PHONE=
# Ofertada ko'rsatiladigan narx matni, masalan "1 000 so'm"
NEXT_PUBLIC_SUBSCRIPTION_PRICE=
